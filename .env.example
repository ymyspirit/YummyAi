POSTGRES_DB=yummyai
POSTGRES_USER=yummyai_local
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_PORT=6379
MINIO_ROOT_USER=yummyai_local_admin
MINIO_ROOT_PASSWORD=
KEYCLOAK_ADMIN=yummyai_local_admin
KEYCLOAK_ADMIN_PASSWORD=
DATABASE_URL=postgresql://yummyai_local:CHANGE_ME@127.0.0.1:5432/yummyai
OIDC_ISSUER=http://localhost:8081/realms/yummyai
OIDC_AUDIENCE=yummyai-api
OIDC_WEB_CLIENT_ID=yummyai-web
OIDC_WEB_REDIRECT_URI=http://localhost:3000/api/erp-auth/callback
WEB_ORIGIN=http://localhost:3000
# Production always requires personal login. local-service is an explicit loopback development option.
WEB_AUTH_MODE=personal
# Dedicated 32-byte base64url secret, different from the factory session key.
ERP_SESSION_ENCRYPTION_KEY=
# Run a separate factory-only Web deployment; never expose the internal ERP proxy.
FACTORY_PORTAL_ONLY=0
FACTORY_PORTAL_ORIGIN=http://localhost:3001
FACTORY_OIDC_CLIENT_ID=yummyai-factory
# Independent 32-byte base64url secret required only by the factory-only deployment.
FACTORY_SESSION_ENCRYPTION_KEY=
LOCAL_OIDC_CLIENT_ID=yummyai-local-web
LOCAL_OIDC_CLIENT_SECRET=
LOCAL_EXTENSION_USER=yummyai-local
LOCAL_EXTENSION_USER_EMAIL=yummyai-extension@yummyai.local
LOCAL_EXTENSION_USER_PASSWORD=
API_BASE_URL=http://127.0.0.1:8000
CANVAS_WORKBENCH_URL=http://127.0.0.1:4175/canvas?mode=recent
CANVAS_STUDIO_URL=http://127.0.0.1:4176
WORKFLOW_CENTER_TENANT_IDS=*
# New order follow-up/inbox rollout is disabled when empty; API and Worker must agree.
ORDER_RESPONSIBILITY_TENANT_IDS=
BUSINESS_FOLLOWUP_TENANT_IDS=
DASHBOARD_DEMO_MODE=0
ANALYSIS_DEMO_MODE=0
PRODUCT_DEMO_MODE=0
DESIGN_DEMO_MODE=0
LISTING_DEMO_MODE=0
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=yummyai_local_admin
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=yummyai-private
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
MARKETPLACE_CREDENTIAL_ENCRYPTION_KEY=
ORDER_PII_ENCRYPTION_KEY=
INTEGRATION_SECRET_ENCRYPTION_KEY=
MODEL_CREDENTIAL_ENCRYPTION_KEY=
KNOWLEDGE_EVIDENCE_ENCRYPTION_KEY=
ORDER_PII_RETENTION_DAYS=90
# Set false and restart Worker to pause durable order-design execution.
ORDER_DESIGN_AGENT_ENABLED=true
# Server-only absolute directory for the pinned Windows Real-ESRGAN runtime (API and Worker).
# Optional in local development: defaults under LOCALAPPDATA/YummyAI/tools.
# Production must explicitly set this path; never expose it through NEXT_PUBLIC_*.
# PILLOW_REALESRGAN_DIR=C:/YummyAI/tools/realesrgan-ncnn-vulkan-20220424
ETSY_APP_KEYSTRING=
ETSY_APP_SHARED_SECRET=
ETSY_OAUTH_REDIRECT_URI=
AMAZON_SPAPI_APPLICATION_ID=
AMAZON_SPAPI_LWA_CLIENT_ID=
AMAZON_SPAPI_LWA_CLIENT_SECRET=
AMAZON_SPAPI_OAUTH_REDIRECT_URI=
AMAZON_SPAPI_AUTH_BASE_URL_NA=https://sellercentral.amazon.com
AMAZON_SPAPI_AUTH_BASE_URL_EU=https://sellercentral.amazon.co.uk
AMAZON_SPAPI_AUTH_BASE_URL_FE=https://sellercentral.amazon.com.au
AMAZON_SPAPI_APP_DRAFT=1
POD_PROCESSOR_URL=
POD_PROCESSOR_API_KEY=
POD_PROCESSOR_DEPLOYMENT_ID=
POD_ENABLED_TOOLS=
# Tenant allowlist for manual model-fee reconciliation; off until role and rollout checks pass.
MODEL_BILLING_TENANT_IDS=
POD_ORDER_PROCESSOR_URL=
POD_ORDER_PROCESSOR_API_KEY=
POD_ORDER_PROCESSOR_DEPLOYMENT_ID=
POD_ORDER_ENABLED_TOOLS=
POD_ORDER_PROCESSOR_MAX_OUTPUT_BYTES=52428800
POD_PROCESSOR_MAX_OUTPUT_BYTES=52428800
POD_EXECUTION_ENCRYPTION_KEY=
WORKER_STARTUP_TIMEOUT_MS=15000
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Unset selection preserves all enabled consumers and timers. Explicit queues
# default to their own dispatchers; select global attention timers separately.
# WORKER_QUEUES=media
# WORKER_SCHEDULERS=none
POD_BATCH_WORKFLOWS_ENABLED=0
POD_MOCKUP_RENDERER_ENABLED=0
POD_MOCKUP_MAGICK_PATH=magick
POD_MOCKUP_RENDER_TIMEOUT_MS=120000
POD_MOCKUP_MAX_OUTPUT_BYTES=52428800
POD_MOCKUP_MAGICK_MEMORY_LIMIT=512MiB
POD_MOCKUP_MAGICK_MAP_LIMIT=1GiB
POD_MOCKUP_MAGICK_DISK_LIMIT=2GiB
POD_MOCKUP_MAGICK_THREAD_LIMIT=2
POD_MOCKUP_MAGICK_FILE_LIMIT=32
POD_MOCKUP_MAGICK_AREA_LIMIT=100MP
POD_MOCKUP_MAGICK_WIDTH_LIMIT=100KP
POD_MOCKUP_MAGICK_HEIGHT_LIMIT=100KP
POD_MOCKUP_MAGICK_TIME_LIMIT=120

# Verified current OMS HTTPS origins and additional trusted PDF download hosts.
# Auto-purchase is enabled per verified connection/rule in the logistics workspace.
YUNEXPRESS_ALLOWED_ORIGINS=
LOGISTICS_LABEL_ALLOWED_HOSTS=

# Dedicated incoming original-input vault: required in production, 32 bytes base64url.
# Preserve the same key across restarts and restore; never reuse another domain key.
INCOMING_COMMAND_ENCRYPTION_KEY=
# Dedicated 32-byte base64 key for procurement originals; never reuse another domain key.
PROCUREMENT_COMMAND_ENCRYPTION_KEY=
# Private finance originals use their own encryption domain in production
FINANCE_COMMAND_ENCRYPTION_KEY=
ADVERTISING_COMMAND_ENCRYPTION_KEY=
