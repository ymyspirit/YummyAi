{
  "name": "@yummyai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:local": "node --env-file=../../.env --import tsx src/bootstrap-local.ts",
    "dev": "node --env-file=../../.env --watch --import tsx src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@yummyai/advertising-core": "workspace:*",
    "@yummyai/ai-core": "workspace:*",
    "@yummyai/authz": "workspace:*",
    "@yummyai/catalog-core": "workspace:*",
    "@yummyai/contracts": "workspace:*",
    "@yummyai/database": "workspace:*",
    "@yummyai/finance-core": "workspace:*",
    "@yummyai/followup-core": "workspace:*",
    "@yummyai/jobs": "workspace:*",
    "@yummyai/knowledge-core": "workspace:*",
    "@yummyai/logistics": "workspace:*",
    "@yummyai/marketplace-connectors": "workspace:*",
    "@yummyai/order-core": "workspace:*",
    "@yummyai/order-design": "workspace:*",
    "@yummyai/order-intake": "workspace:*",
    "@yummyai/platform-rules": "workspace:*",
    "@yummyai/pod-core": "workspace:*",
    "@yummyai/production-editor": "workspace:*",
    "@yummyai/storage": "workspace:*",
    "@yummyai/workflow-core": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "fast-xml-parser": "^5.11.1",
    "jose": "^6.0.0",
    "jszip": "3.10.1",
    "mediabunny": "1.62.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.3",
    "zod": "^4.0.0",
    "@yummyai/mockup-renderer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bullmq": "^5.80.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
