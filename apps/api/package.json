{
  "name": "@yummyai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap:local": "node --env-file=../../.env --import tsx src/bootstrap-local.ts",
    "dev": "node --env-file=../../.env --watch --import tsx src/main.ts",
    "start": "node --env-file=../../.env --import tsx src/main.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.1.28",
    "@yummyai/ai-core": "workspace:*",
    "@yummyai/authz": "workspace:*",
    "@yummyai/contracts": "workspace:*",
    "@yummyai/database": "workspace:*",
    "@yummyai/jobs": "workspace:*",
    "@yummyai/platform-rules": "workspace:*",
    "@yummyai/storage": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "jose": "^6.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
