{
  "name": "@yummyai/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../tools/scripts/build-canvas-plugin.mjs && node --env-file-if-exists=../../.env ../../tools/scripts/check-web-env.mjs",
    "dev": "node --env-file-if-exists=../../.env ../../tools/scripts/start-web.mjs dev",
    "build": "node ../../tools/scripts/build-canvas-plugin.mjs && next build",
    "prestart": "node --env-file-if-exists=../../.env ../../tools/scripts/check-web-env.mjs --production",
    "start": "node --env-file-if-exists=../../.env ../../tools/scripts/start-web.mjs start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "@yummyai/authz": "workspace:*",
    "@yummyai/catalog-core": "workspace:*",
    "@yummyai/contracts": "workspace:*",
    "@yummyai/platform-rules": "workspace:*",
    "@yummyai/production-editor": "workspace:*",
    "fabric": "7.4.0",
    "geist": "^1.7.2",
    "ioredis": "5.11.1",
    "jose": "6.2.3",
    "lucide-react": "^1.25.0",
    "next": "^16.2.10",
    "opentype.js": "^1.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.0.0",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@yummyai/database": "workspace:*",
    "@yummyai/infinite-canvas-plugin": "workspace:*",
    "@yummyai/storage": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
