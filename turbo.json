{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "OIDC_AUDIENCE",
        "OIDC_ISSUER",
        "REDIS_URL",
        "S3_ACCESS_KEY_ID",
        "S3_ENDPOINT",
        "S3_PRIVATE_BUCKET",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY"
      ],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    }
  }
}
