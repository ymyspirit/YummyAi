{
  "name": "yummyai-erp",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.17 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env node_modules/turbo/bin/turbo dev",
    "build": "turbo build",
    "check:rules": "node --test tools/tests/project-rules.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo typecheck",
    "test": "pnpm check:rules && turbo test",
    "test:integration": "turbo test:integration",
    "test:e2e": "node tools/scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.61.1",
    "eslint": "^9.0.0",
    "jszip": "^3.10.1",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
