{
  "name": "yummyai-erp",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.17 <25"
  },
  "scripts": {
    "canvas:verify-upstream": "node tools/scripts/canvas-upstream.mjs verify",
    "canvas:check-upstream": "node tools/scripts/canvas-upstream.mjs check",
    "canvas:compare-upstream": "node tools/scripts/canvas-upstream.mjs compare",
    "canvas:record-upstream": "node tools/scripts/canvas-upstream.mjs record",
    "canvas:build": "node tools/scripts/build-canvas-plugin.mjs",
    "canvas:start": "node tools/scripts/unified-compose.mjs start-legacy",
    "studio:dev": "node --env-file-if-exists=.env tools/scripts/serve-canvas-runtime.mjs",
    "studio:start": "node tools/scripts/studio-runtime-deployment.mjs start",
    "studio:prepare": "node tools/scripts/studio-runtime-deployment.mjs prepare-current",
    "studio:adopt": "node tools/scripts/studio-runtime-deployment.mjs adopt",
    "studio:status": "node tools/scripts/studio-runtime-deployment.mjs status",
    "studio:recover": "node tools/scripts/studio-runtime-deployment.mjs recover",
    "start:local": "pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File tools/scripts/start-local.ps1",
    "start:personal:api": "pnpm --filter @yummyai/api start",
    "start:personal:web": "pnpm --filter @yummyai/web start --hostname 127.0.0.1 --port 3000",
    "daily:start": "node tools/scripts/ordinary-runtime.mjs start",
    "daily:status": "node tools/scripts/ordinary-runtime.mjs status",
    "docker:up": "node tools/scripts/unified-compose.mjs start",
    "docker:status": "node tools/scripts/unified-compose.mjs status",
    "docker:check": "node tools/scripts/unified-compose.mjs check --live",
    "build:web:candidate": "node tools/scripts/local-web-candidate.mjs build",
    "check:web:candidate": "node tools/scripts/local-web-candidate.mjs verify",
    "identity:setup:local": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/scripts/setup-local-personal-identity.mts",
    "worker:inspect": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/scripts/inspect-local-worker-queues.mts",
    "start:local:material-retention": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/scripts/material-retention-runtime.mjs",
    "start:local:incoming-retention": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/scripts/incoming-retention-runtime.mjs",
    "dev": "node --env-file=.env node_modules/turbo/bin/turbo dev",
    "dev:lite": "node --env-file=.env node_modules/turbo/bin/turbo dev --filter=@yummyai/api --filter=@yummyai/web",
    "dev:api": "node --env-file=.env node_modules/turbo/bin/turbo dev --filter=@yummyai/api",
    "dev:web": "node --env-file=.env node_modules/turbo/bin/turbo dev --filter=@yummyai/web",
    "dev:worker": "node --env-file=.env node_modules/turbo/bin/turbo dev --filter=@yummyai/worker",
    "dev:extension": "node --env-file=.env node_modules/turbo/bin/turbo dev --filter=@yummyai/extension",
    "dev:full": "node --env-file=.env node_modules/turbo/bin/turbo dev",
    "infra:up": "node tools/scripts/unified-compose.mjs infrastructure up",
    "infra:lite": "node tools/scripts/unified-compose.mjs infrastructure lite",
    "infra:full": "node tools/scripts/unified-compose.mjs infrastructure full",
    "infra:file-scanning": "node tools/scripts/unified-compose.mjs infrastructure file-scanning",
    "infra:observability": "node tools/scripts/unified-compose.mjs infrastructure observability",
    "check:local-runtime": "node --env-file=.env tools/scripts/check-local-runtime.mjs",
    "build": "turbo build",
    "check:rules": "node --test tools/tests/project-rules.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "release:manifest": "node tools/scripts/create-release-candidate-manifest.mjs",
    "typecheck": "turbo typecheck",
    "test": "pnpm check:rules && pnpm test:tools && turbo test",
    "test:integration": "node --env-file=.env tools/scripts/run-integration-acceptance.mjs",
    "test:tools": "node --import ./apps/api/node_modules/tsx/dist/loader.mjs --test tools/tests/source-secret-scan.test.mjs tools/tests/workspace.test.mjs tools/tests/release-candidate-manifest.test.mjs tools/tests/canvas-upstream.test.mjs tools/tests/knowledge-browser-sandbox.test.mjs tools/tests/web-identity-preflight.test.mjs tools/tests/local-web-candidate.test.mjs tools/tests/backup-restore.test.mjs tools/tests/order-reset-plan.test.mjs tools/tests/upgrade-system-actor-policy.test.mjs tools/tests/personal-identity-plan.test.mjs tools/tests/integration-lifecycle.test.mjs tools/tests/acceptance-output.test.mjs tools/tests/material-retention-runtime.test.mjs tools/tests/procurement-retention-runtime.test.mjs tools/tests/ordinary-runtime.test.mjs tools/tests/ordinary-runtime-startup.test.mjs tools/tests/runtime-maintenance-serialization.test.mjs tools/tests/unified-compose-model.test.mjs tools/tests/studio-runtime-artifact.test.mjs tools/tests/agent-native-v4-environment.test.mjs tools/tests/shipment-create-environment.test.mjs tools/tests/studio-runtime-gateway.test.mjs tools/tests/studio-original-environment.test.mjs tools/tests/unified-compose-image-review.test.mjs tools/tests/unified-compose-image-lifecycle.test.mjs tools/tests/unified-compose-image-commands.test.mjs tools/tests/studio-document-transfer-browser-lock.test.mjs tools/tests/studio-video-directory-environment.test.mjs tools/tests/studio-model-selection-environment.test.mjs tools/tests/creative-recovery-isolation.test.mjs tools/tests/studio-draft-recovery-environment.test.mjs tools/testing/creative-response-adoption-environment.test.mjs tools/tests/studio-paid-image-environment.test.mjs tools/testing/creative-owner-response-adoption-environment.test.mjs tools/tests/p2-browser-lock.test.mjs tools/tests/p2-browser-suite-results.test.mjs",
    "test:e2e": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/scripts/run-order-daily-acceptance.mts",
    "test:e2e:order-daily": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/scripts/run-order-daily-acceptance.mts",
    "test:integration:worker-runtime": "pnpm test:e2e:order-daily --suite=worker-runtime",
    "test:e2e:design-agent": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/scripts/run-order-daily-acceptance.mts --suite=design-agent",
    "test:integration:design-agent": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/scripts/run-order-daily-acceptance.mts --suite=design-agent-integration",
    "start:local:procurement-retention": "node --env-file=.env --import ./apps/api/node_modules/tsx/dist/loader.mjs tools/scripts/procurement-retention-runtime.mjs",
    "check:secrets": "node tools/scripts/source-secret-scan.mjs",
    "test:e2e:legacy-smoke": "node tools/scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.61.1",
    "eslint": "^9.0.0",
    "jszip": "^3.10.1",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
